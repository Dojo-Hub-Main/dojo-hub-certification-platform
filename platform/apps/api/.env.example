# --- Server ---
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://dojo:dojo@localhost:5432/dojo_hub?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Credential signing ---
CREDENTIAL_HMAC_SECRET="change-me-credential-hmac-secret"

# --- Object storage (S3-compatible / MinIO for local dev) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="dojo-hub-files"
S3_ACCESS_KEY_ID="dojo_minio"
S3_SECRET_ACCESS_KEY="dojo_minio_secret"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9000/dojo-hub-files"

# --- AI grading (Claude API) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
